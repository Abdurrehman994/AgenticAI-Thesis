# Copy to .env and fill in. .env is git-ignored.
# 3DSpace root as used in Postman (cloud tenants end in /enovia)
PLM_SPACE_URL=https://r0000000000000-eu1-space.3dexperience.3ds.com/enovia
# 3DPassport root
PLM_PASSPORT_URL=https://eu1-ds-iam.3dexperience.3ds.com
PLM_USERNAME=
PLM_PASSWORD=
# Same value as the SecurityContext header in Postman: Role.Organization.CollabSpace
PLM_SECURITY_CONTEXT=VPLMProjectLeader.Company Name.API_development
# Optional: defaults to the first part of PLM_SPACE_URL's host, upper-cased (r1234-... -> R1234)
# PLM_TENANT=

# LLM suggester (run_agent.py --suggester llm): any OpenAI-compatible endpoint
# Lehmus AI: endpoint and key from ICT Services; LLM_MODEL is the "public model id" (gpt-oss-120b below)
# Ollama on this machine: LLM_BASE_URL=http://localhost:11434/v1, no key, LLM_MODEL e.g. qwen3:8b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=azsydsttjnlbfjbgqnwd
# Optional: name shown in reports instead of the model id
LLM_LABEL=gpt-oss-120b
# LLM_TEMPERATURE=0
# LLM_TIMEOUT=120
